# Copied from Orbit Ops: a bare #N in these comments is an Orbit Ops issue.
# #324 — runs apply-backup.service once a night.
#
# The time is New York's (APP_TIMEZONE), whatever the droplet's own clock is set
# to, so it stays in Sean's small hours across daylight saving. Persistent=true runs a missed night's dump as soon
# as the droplet is back, after a reboot or an outage.
[Unit]
Description=Nightly Job Hunt database backup

[Timer]
# 03:45, a quarter hour after Orbit Ops's, so the two dumps never overlap on the shared box.
OnCalendar=*-*-* 03:45:00 America/New_York
Persistent=true

[Install]
WantedBy=timers.target
