# The virtual screen /apply's browser draws on (docs/apply.md). A user service:
#   tools/apply-screen.sh install   (links it and jobhunt-vnc.service, enables both)
[Unit]
Description=Job Hunt: the virtual screen (:99) for /apply's browser

[Service]
ExecStart=/usr/bin/Xvfb :99 -screen 0 1440x900x24 -nolisten tcp
Restart=on-failure

[Install]
WantedBy=default.target
