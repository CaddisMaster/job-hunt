# Copy to .env and fill in. NEVER commit .env.

# The image version compose runs. Required — there is deliberately no default.
# Locally the override builds from source, but compose still interpolates this.
TAG=dev

# Postgres owner: creates the database, owns the tables, runs migrations.
DB_HOST=db
DB_PORT=5432
DB_NAME=apply
DB_USER=apply
DB_PASSWORD=change-me

# Least-privilege role the web app connects as (DML only, no DDL). Created by
# migration 0001 WITHOUT a password; set one by hand (RUNBOOK.md). Leave both
# blank locally to connect as DB_USER.
DB_APP_USER=
DB_APP_PASSWORD=

# Signs the session cookie. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# 1 in production (HTTPS): Secure cookies + HSTS. 0 locally over plain HTTP.
COOKIE_SECURE=0

# IANA timezone for "today" (the morning queue, the nightly run).
APP_TIMEZONE=America/New_York

# Login attempts allowed per client address per minute (counted in Postgres).
LOGIN_RATE_LIMIT=10

# Claude API key for the AI features (#22). Every user's calls run on it. Leave
# blank to turn AI off: the pages say so, nothing errors.
ANTHROPIC_API_KEY=

# Monthly AI caps in cents, per user and for everyone together (calendar months in
# APP_TIMEZONE). A call that would start over either cap is refused before it's made.
AI_MONTHLY_BUDGET_CENTS_PER_USER=200
AI_MONTHLY_BUDGET_CENTS=1000

# Job search aggregators (#45), searched each night for everyone's confirmed target
# titles. Blank = that source is skipped (the crawl's summary says so). Each has a
# daily request budget, counted in Postgres; keep it inside the free tier shown in
# your Adzuna account (developer.adzuna.com).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_DAILY_REQUESTS=80
# developer.usajobs.gov/apirequest/. USAJOBS_USER_AGENT is the email the key was issued to.
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=
USAJOBS_DAILY_REQUESTS=100
